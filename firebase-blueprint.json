{
  "entities": {
    "characters": {
      "title": "Character",
      "description": "Custom and player characters created in the SLG tactical game",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "isGlobal": { "type": "boolean" },
        "name": { "type": "string" },
        "unitClass": { "type": "string" },
        "classType": { "type": "string" },
        "avatar": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stats": { "type": "object" },
        "favorability": { "type": "number" },
        "customSkill": { "type": "object" },
        "skillTree": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "classType"]
    },
    "skills": {
      "title": "Skill",
      "description": "Skill tree nodes and custom abilities",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "costAP": { "type": "number" },
        "cooldown": { "type": "number" },
        "targetType": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "game_configs": {
      "title": "GameConfig",
      "description": "Global unit configurations, balance tuning and custom class asset mappings",
      "properties": {
        "id": { "type": "string" },
        "unitImages": { "type": "object" },
        "balance": { "type": "object" },
        "unitStats": { "type": "object" },
        "worldSectors": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "maps": {
      "title": "Map",
      "description": "Grid tile map data and terrain layout",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tiles": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "tiles"]
    },
    "gameState": {
      "title": "GameState",
      "description": "Player game progress and board state",
      "properties": {
        "userId": { "type": "string" },
        "turn": { "type": "number" },
        "gold": { "type": "number" },
        "playerUnits": { "type": "array" },
        "enemyUnits": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "turn"]
    },
    "scenarioMaps": {
      "title": "ScenarioMap",
      "description": "8x14 Tactical scenario sector maps with terrain, roads, structures and unit placements",
      "properties": {
        "sectorId": { "type": "string" },
        "cols": { "type": "number" },
        "rows": { "type": "number" },
        "tiles": { "type": "array" },
        "units": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sectorId", "tiles"]
    }
  },
  "firestore": {
    "/characters/{charId}": {
      "schema": "characters",
      "description": "All custom characters and global roster"
    },
    "/skills/{skillId}": {
      "schema": "skills",
      "description": "Skill definitions and skill tree nodes"
    },
    "/game_configs/{configId}": {
      "schema": "game_configs",
      "description": "Game configuration parameters and class images"
    },
    "/maps/{mapId}": {
      "schema": "maps",
      "description": "Map layouts and sectors"
    },
    "/scenarioMaps/{sectorId}": {
      "schema": "scenarioMaps",
      "description": "Dynamic 8x14 sector tactical maps for world sectors"
    },
    "/gameState/{docId}": {
      "schema": "gameState",
      "description": "Game saves and runtime progress"
    }
  }
}
